{
  "name": "suman.ts",
  "version": "0.0.1004",
  "description": "Suman project with TypeScript metadata",
  "main": "lib/index.js",
  "scripts": {
    "test": "suman",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjs/suman.ts.git"
  },
  "keywords": [
    "suman",
    "testing"
  ],
  "author": "Olegzandr",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sumanjs/suman.ts/issues"
  },
  "homepage": "https://github.com/sumanjs/suman.ts#readme",
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
